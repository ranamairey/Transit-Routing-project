# NFR-3.2: automatic HTTPS. Replace the domains, then: docker compose --profile tls up -d
# Rider app + API
transit.example.com {
    encode gzip
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy web:80
    }
}

# Admin console (separate origin)
admin.transit.example.com {
    encode gzip
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy admin:80
    }
}
