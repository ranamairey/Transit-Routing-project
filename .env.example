# Copy to .env and fill in. `.env` is git-ignored and must never be committed.
# All three values below are REQUIRED: the backend refuses to start without them.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/
JWT_SECRET=<long random string, 32+ characters>
SEED_ADMIN_PASSWORD=<password for the first admin account>

MONGO_DB=syrian_transit
SEED_ADMIN_EMAIL=admin@example.com
# Optional: creates two demo rider accounts (ahmad@demo.com, samer@demo.com) and sample reports on first start.
SEED_USER_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
