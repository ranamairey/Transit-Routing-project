# Used by `npm run build:android`. The Android app has no dev proxy, so the API origin must be absolute.
# Android emulator reaching a backend on this computer:
VITE_API_BASE=http://10.0.2.2:8080
# A real phone on the same Wi-Fi: VITE_API_BASE=http://<this-computer-ip>:8080
# Production: VITE_API_BASE=https://api.your-domain.com
