# Backend origin. Leave empty in dev (Vite proxies /api to http://localhost:8080) and when the
# web build is served behind the same host as the API (docker-compose).
VITE_API_BASE=

# Optional link to the separate admin console shown to admins in the top bar.
VITE_ADMIN_URL=http://localhost:5174

# Optional map tiles with your own key (default: OpenStreetMap, no key). Dark tiles optional; otherwise light tiles are inverted.
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/256/{z}/{x}/{y}.png?key=YOUR_KEY
